# Copia este archivo a .env y rellena los valores de tu tenant en Azure Portal.
# Puedes reutilizar las mismas apps que en entra-spring-security (misma API y cliente).

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
