# Copia este archivo a .env y rellena los valores de tu tenant en Azure Portal.
# Ver README.md para registrar las aplicaciones en Entra ID.

# Directory (tenant) ID — Azure Portal > Microsoft Entra ID > Información general
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client ID de la app "API" (resource server) — App roles definidos aquí
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Audience del token (suele coincidir con el Application ID URI de la API)
# Ejemplo: api://00000000-0000-0000-0000-000000000000
AZURE_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# Client ID de la app cliente (flujo device code / SPA) — permisos delegados a la API
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Scope para pedir el token (debe incluir la API)
# Formato habitual: api://<API_CLIENT_ID>/access_as_user
AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
