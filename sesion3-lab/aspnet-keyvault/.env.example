# Mismo tenant que las demos Entra (sesion2-lab/entra-spring-security / entra-aspnet).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# URI del Key Vault creado en Azure Portal (Ejercicio 2).
KEY_VAULT_URI=https://tu-keyvault.vault.azure.net/

# --- Local con `dotnet run` + `az login` (recomendado en el laboratorio) ---
# No hace falta rellenar client secret: DefaultAzureCredential usa tu sesion de Azure CLI.

# --- Docker / CI (opcional): App registration con secret para acceder al Key Vault ---
# Crea una app "keyvault-demo-sp", asignale "Key Vault Secrets User" en el vault y anade un client secret.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=tu-client-secret
