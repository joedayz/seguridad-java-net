# Credenciales AppRole con las que la app se autentica en Vault.
# En esta demo el contenedor "vault-init" siembra estos MISMOS valores en Vault,
# asi que el laboratorio funciona sin pasos manuales.
#
# En un entorno real:
#   - NO se fijan a mano: se generan con `vault read auth/approle/role/spring-app/role-id`
#     y `vault write -f auth/approle/role/spring-app/secret-id`.
#   - El secret-id es de un solo uso / con TTL y nunca se commitea.
VAULT_ROLE_ID=spring-app-role-id
VAULT_SECRET_ID=spring-app-secret-id
